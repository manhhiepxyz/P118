# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# Chọn đúng một provider: openai | openrouter
# openai | openrouter | deepseek
LLM_PROVIDER=deepseek

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# OpenRouter (OpenAI-compatible). Để test model miễn phí:
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# DeepSeek — API tương thích OpenAI.
# Gate 2 CHỐT đúng model deepseek-v4-flash: deepseek-reasoner bật
# chain-of-thought nên structured output không ổn định, còn deepseek-chat và
# các bản pro là model khác hẳn. Đặt giá trị khác sẽ fail-fast lúc khởi tạo.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model OpenAI khi LLM_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
# Planner cần kết quả ổn định
LLM_TEMPERATURE=0

# Other providers (chưa tích hợp):
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database (PostgreSQL) ----
# Khi chạy local (không Docker):
DATABASE_URL=postgresql://p118:p118pass@localhost:5432/p118_db
# Khi chạy trong Docker Compose, backend tự override bằng service name "postgres"

# Thông tin kết nối riêng (dùng bởi docker-compose.yml)
POSTGRES_USER=p118
POSTGRES_PASSWORD=p118pass
POSTGRES_DB=p118_db
POSTGRES_PORT=5432

# Test DB riêng (dùng khi chạy pytest)
TEST_DATABASE_URL=postgresql://p118:p118pass@localhost:5432/p118_test_db

# ---- Mock Provider URLs ----
RESIDENT_SERVICE_URL=http://localhost:8001
TRANSPORT_SERVICE_URL=http://localhost:8002
PAYMENT_SERVICE_URL=http://localhost:8003
PROPERTY_SERVICE_URL=http://localhost:8005
RESIDENT_SERVICES_SERVICE_URL=http://localhost:8006

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
# LƯU Ý BẢO MẬT: chỗ này từng chứa một key thật đã bị commit.
# Key đó phải được THU HỒI: nó vẫn nằm trong git history.
AI_LOG_API_KEY=your-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
