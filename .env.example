# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# Chọn đúng một provider: openai | openrouter | deepseek | groq
LLM_PROVIDER=deepseek

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# OpenRouter (OpenAI-compatible). Để test model miễn phí:
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# DeepSeek — API tương thích OpenAI.
# Gate 2 CHỐT đúng model deepseek-v4-flash: deepseek-reasoner bật
# chain-of-thought nên structured output không ổn định, còn deepseek-chat và
# các bản pro là model khác hẳn. Đặt giá trị khác sẽ fail-fast lúc khởi tạo.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Groq — API tương thích OpenAI, chạy trên phần cứng riêng nên nhanh hơn hẳn ở
# cùng một model.
#
# KHÔNG khoá cứng tên model như DeepSeek: danh mục Groq đổi thường xuyên và họ
# gỡ model cũ, nên khoá lại sẽ biến một lần dọn danh mục bên họ thành sự cố bên
# mình. Chỉ chặn kiểu gõ nhầm đã có tiền lệ — để nguyên tên model DeepSeek.
#
# Lưu ý: `reasoning_effort` KHÔNG được gửi cho Groq. Groq chỉ nhận tham số này
# trên vài model suy luận (qwen3, gpt-oss); gửi tới llama-3.3 là 400 ngay.
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model OpenAI khi LLM_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
# Planner cần kết quả ổn định
LLM_TEMPERATURE=0

# Other providers (chưa tích hợp):
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database (PostgreSQL) ----
# Khi chạy local (không Docker):
DATABASE_URL=postgresql://p118:p118pass@localhost:5432/p118_db
# Khi chạy trong Docker Compose, backend tự override bằng service name "postgres"

# Thông tin kết nối riêng (dùng bởi docker-compose.yml)
POSTGRES_USER=p118
POSTGRES_PASSWORD=p118pass
POSTGRES_DB=p118_db
POSTGRES_PORT=5432

# Test DB riêng (dùng khi chạy pytest)
TEST_DATABASE_URL=postgresql://p118:p118pass@localhost:5432/p118_test_db

# ---- Mock Provider URLs ----

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Auth (JWT-like HMAC token) ----
# Sinh secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
# BẮT BUỘC: JWT_SECRET phải giống nhau giữa lúc tạo token (login) và verify.
JWT_SECRET=change-me-with-secrets-token-urlsafe

# ---------------------------------------------------------------------------
# Quan sát
# ---------------------------------------------------------------------------
# Bật để xem model đang làm gì ngay trong log backend — mỗi việc một dòng:
# planner quyết gì, tác vụ nào hỏng vì sao, câu trả lời ra sao.
#
#   docker compose logs -f backend | grep --line-buffered -E "\[(plan|chạy|respond)/"
#
# Mặc định TẮT: trace in cả nội dung người dùng gõ, không nên chạy thường trực.
# Đặt `full` thay vì `1` nếu cần xem nguyên văn prompt gửi cho model.
P118_LLM_TRACE=0
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
# LƯU Ý BẢO MẬT: chỗ này từng chứa một key thật đã bị commit.
# Key đó phải được THU HỒI: nó vẫn nằm trong git history.
AI_LOG_API_KEY=your-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Mock provider (một tool một owner, một service một cổng) ---
RESIDENT_SERVICE_URL=http://localhost:8001
TRANSPORT_SERVICE_URL=http://localhost:8002
PAYMENT_SERVICE_URL=http://localhost:8003
PROPERTY_SERVICE_URL=http://localhost:8008
TOUR_SERVICE_URL=http://localhost:8005
RESIDENT_SERVICES_SERVICE_URL=http://localhost:8006
CONSULTATION_SERVICE_URL=http://localhost:8007
# book_shuttle là experimental, không đăng ký runtime. Chạy bằng
# `docker compose --profile experimental up mock-shuttle` nếu cần thử.
SHUTTLE_SERVICE_URL=http://localhost:8009
