# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# Chọn đúng một provider: openai | openrouter
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# OpenRouter (OpenAI-compatible). Để test model miễn phí:
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model OpenAI khi LLM_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
# Planner cần kết quả ổn định
LLM_TEMPERATURE=0

# Other providers (chưa tích hợp):
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database (PostgreSQL) ----
# Khi chạy local (không Docker):
DATABASE_URL=postgresql://p118:p118pass@localhost:5432/p118_db
# Khi chạy trong Docker Compose, backend tự override bằng service name "postgres"

# Thông tin kết nối riêng (dùng bởi docker-compose.yml)
POSTGRES_USER=p118
POSTGRES_PASSWORD=p118pass
POSTGRES_DB=p118_db
POSTGRES_PORT=5432

# Test DB riêng (dùng khi chạy pytest)
TEST_DATABASE_URL=postgresql://p118:p118pass@localhost:5432/p118_test_db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Auth (JWT-like HMAC token) ----
# Sinh secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
# BẮT BUỘC: JWT_SECRET phải giống nhau giữa lúc tạo token (login) và verify.
JWT_SECRET=change-me-with-secrets-token-urlsafe
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
