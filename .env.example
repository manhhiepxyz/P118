# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ==============================================================================
# 5. Google Authentication
# ==============================================================================
# Google Client ID dùng cho Đăng nhập bằng Google
# Lấy từ Google Cloud Console (APIs & Services > Credentials)
# Backend dùng để verify token:
GOOGLE_CLIENT_ID=""
# Frontend dùng để render nút đăng nhập:
VITE_GOOGLE_CLIENT_ID=""

# ---- LLM Configuration ----
# Chọn đúng một provider: openai | openrouter | deepseek | groq
LLM_PROVIDER=deepseek

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# OpenRouter (OpenAI-compatible). Để test model miễn phí:
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# DeepSeek — API tương thích OpenAI.
# Gate 2 CHỐT đúng model deepseek-v4-flash: deepseek-reasoner bật
# chain-of-thought nên structured output không ổn định, còn deepseek-chat và
# các bản pro là model khác hẳn. Đặt giá trị khác sẽ fail-fast lúc khởi tạo.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Groq — API tương thích OpenAI, chạy trên phần cứng riêng nên nhanh hơn hẳn ở
# cùng một model.
#
# KHÔNG khoá cứng tên model như DeepSeek: danh mục Groq đổi thường xuyên và họ
# gỡ model cũ, nên khoá lại sẽ biến một lần dọn danh mục bên họ thành sự cố bên
# mình. Chỉ chặn kiểu gõ nhầm đã có tiền lệ — để nguyên tên model DeepSeek.
#
# Lưu ý 1: `reasoning_effort` KHÔNG được gửi cho Groq. Groq chỉ nhận tham số
# này trên vài model suy luận; gửi tới model khác là 400 ngay.
#
# Lưu ý 2 — ĐO ĐƯỢC, ĐỌC TRƯỚC KHI DÙNG: gói `on_demand` (free) của Groq giới
# hạn 8.000 token/phút. Một lời gọi Planner cần ~8.158 token (system prompt
# 6.866 + schema function-calling + payload), nên nó KHÔNG BAO GIỜ lọt — kể cả
# một lần mỗi phút. Lớp trả lời thì chạy tốt (~1.600 token, đo 1,0–1,4 giây).
# Muốn chạy Planner trên Groq thì phải nâng Dev Tier.
GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model OpenAI khi LLM_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
# Planner cần kết quả ổn định
LLM_TEMPERATURE=0

# Other providers (chưa tích hợp):
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database (PostgreSQL) ----
# Khi chạy local (không Docker):
DATABASE_URL=postgresql://p118:p118pass@localhost:5432/p118_db
# Khi chạy trong Docker Compose, backend tự override bằng service name "postgres"

# Thông tin kết nối riêng (dùng bởi docker-compose.yml)
POSTGRES_USER=p118
POSTGRES_PASSWORD=p118pass
POSTGRES_DB=p118_db
POSTGRES_PORT=5432

# Test DB riêng (dùng khi chạy pytest)
TEST_DATABASE_URL=postgresql://p118:p118pass@localhost:5432/p118_test_db

# ---- Mock Provider URLs ----

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Auth (JWT-like HMAC token) ----
# Sinh secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
# BẮT BUỘC: JWT_SECRET phải giống nhau giữa lúc tạo token (login) và verify.
JWT_SECRET=change-me-with-secrets-token-urlsafe

# ---------------------------------------------------------------------------
# Quan sát
# ---------------------------------------------------------------------------
# Bật để xem model đang làm gì ngay trong log backend — mỗi việc một dòng:
# planner quyết gì, tác vụ nào hỏng vì sao, câu trả lời ra sao.
#
#   docker compose logs -f backend | grep --line-buffered -E "\[(plan|chạy|respond)/"
#
# Mặc định TẮT: trace in cả nội dung người dùng gõ, không nên chạy thường trực.
# Đặt `full` thay vì `1` nếu cần xem nguyên văn prompt gửi cho model.
P118_LLM_TRACE=0

# Chọn đơn vị cung cấp theo BÁO GIÁ: hỏi giá nhiều đơn vị, đề xuất một đơn vị,
# khách xác nhận, rồi mới tới hàng đợi duyệt của đơn vị ấy.
#
# TẮT mặc định, và chỉ bật bằng đúng chuỗi "1". Mọi giá trị khác — "", "true",
# "yes", "01" — đều tắt. Đây là fail-closed cho một tính năng đụng vào tiền:
# một cấu hình gõ sai phải để hệ thống chạy như cũ, chứ không bật một đường mới
# chưa ai xem lại.
SERVICE_PROVIDER_MATCHING=0
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
# LƯU Ý BẢO MẬT: chỗ này từng chứa một key thật đã bị commit.
# Key đó phải được THU HỒI: nó vẫn nằm trong git history.
AI_LOG_API_KEY=your-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Mock provider (một tool một owner, một service một cổng) ---
RESIDENT_SERVICE_URL=http://localhost:8001
TRANSPORT_SERVICE_URL=http://localhost:8002
PAYMENT_SERVICE_URL=http://localhost:8003
PROPERTY_SERVICE_URL=http://localhost:8008
TOUR_SERVICE_URL=http://localhost:8005
RESIDENT_SERVICES_SERVICE_URL=http://localhost:8006
CONSULTATION_SERVICE_URL=http://localhost:8007
# book_shuttle là experimental, không đăng ký runtime. Chạy bằng
# `docker compose --profile experimental up mock-shuttle` nếu cần thử.
SHUTTLE_SERVICE_URL=http://localhost:8009

# ---- Cổng thanh toán VNPay (tùy chọn) ----
# mock  = luồng đồng bộ hiện tại (duyệt là xong). Mặc định, an toàn cho demo.
# vnpay = redirect sang VNPay sandbox + xác nhận qua IPN máy-nhân-máy.
PAYMENT_PROVIDER=mock

# Đăng ký sandbox tại https://sandbox.vnpayment.vn/devreg/ rồi điền vào đây.
# KHÔNG commit giá trị thật — HASH_SECRET tương đương khóa chữ ký tài chính.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# Phiên thanh toán hết hạn sau N phút; sweeper sẽ đóng các phiên quá hạn.
VNPAY_SESSION_TTL_MINUTES=30

# Backend phải có địa chỉ CÔNG KHAI để VNPay gọi IPN về (ngrok/cloudflared
# khi chạy local, hoặc URL Render/Railway khi đã deploy).
PUBLIC_BASE_URL=
# Frontend để trả trình duyệt user về trang kết quả thanh toán.
# Local: http://localhost:5173
# Production/Render: https://www.c3-app-118.io.vn
# Email cập nhật workflow dùng giá trị này để tạo nút mở đúng trang chi tiết.
FRONTEND_BASE_URL=http://localhost:5173

# ---- Hạn ngạch ngày ----
# Thứ DUY NHẤT thật sự chặn dùng vô hạn. `RATE_LIMIT_PER_MINUTE` chặn bùng phát
# tức thời nhưng khoá theo ĐỊA CHỈ IP — đổi mạng là reset, và 20/phút vẫn cho
# phép 28.800 request/ngày.
#
# Đo được: mỗi workflow ~12.264 token ≈ $0,00365 → 50/ngày là trần $0,18/người.
# Lời chào và câu hỏi năng lực KHÔNG tính (không tạo workflow, gần như miễn phí).
# 0 = tắt.
DAILY_WORKFLOW_QUOTA=50
DAILY_QUOTA_WINDOW_HOURS=24

#vnpay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# Email giao dịch qua Resend SMTP.
#
# 1. Xác minh `account.c3-app-118.io.vn` trong Resend.
# 2. Tạo API key và chỉ đặt nó trong `.env`/secret của môi trường deploy.
# 3.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@c3-app-118.io.vn
RESEND_FROM_NAME=P-118
