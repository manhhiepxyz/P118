      "Bash(python -m pytest tests/test_api/test_workflow_routes.py -q)",
      "Bash(git -C d:/AI20KLab/P-118 diff --stat)",
      "Bash(python -m pytest tests/test_db/test_repository.py -q -k \"list_workflows\")",
      "Bash(TEST_DATABASE_URL=\"postgresql://postgres:root@localhost:5432/p118_test_db\" python -m pytest tests/test_db/test_repository.py -q -k \"list_workflows\")",
      "Bash(TEST_DATABASE_URL=\"postgresql://postgres:root@localhost:5432/p118_test_db\" python -m pytest tests/test_db/test_repository.py -q)",
