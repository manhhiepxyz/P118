{
  "permissions": {
    "allow": [
      "PowerShell(python -m pytest tests/test_small_talk.py::test_chat_route_capability -v 2>&1)",
      "Bash(python -m pytest tests/test_api/test_rate_limit.py -v)",
      "Bash(python -m pytest tests/test_small_talk.py tests/test_api/test_routes.py -q)",
      "Bash(python -m pytest tests/test_small_talk.py tests/test_api/test_routes.py tests/test_api/test_rate_limit.py -q)",
      "Bash(python -m pytest tests/test_api/test_rate_limit.py tests/test_api/test_routes.py tests/test_small_talk.py -q)",
      "Bash(python -m pytest tests/test_execution_metrics.py -v)",
      "Bash(python -m pytest tests/test_eval_harness.py -v)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=claude",
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=claude",
            "shell": "bash"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=claude",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
