skinparam classAttributeIconSize 0

title Class Diagram\nCore Data Structures & Contracts

' ===========================================================================
' TaskPlan structures
' ===========================================================================
class TaskStep {
    + id: str
    + tool: Literal["register_resident",
                     "register_vehicle",
                     "book_parking",
                     "pay_fee"]
    + depends_on: list[str]
    + input_mapping: dict[str, str]
    + estimated_cost: int | None
}

class TaskPlan {
    + tasks: list[TaskStep]
    + validate_plan(cls, tasks)
    __
    **Validation rules:**
    - Unique task IDs
    - depends_on refs valid IDs
    - No cyclic dependencies
}

TaskPlan "1" *-- "many" TaskStep : contains

' ===========================================================================
' StandardResult (service contract)
' ===========================================================================
class StandardResult {
    + success: bool
    + status: str
    + transaction_id: str | None
    + data: dict | None
    + error: ServiceError | None
    + meta: ResultMeta
}

class ServiceError {
    + code: str
    + message: str
    + retryable: bool
}

class ResultMeta {
    + idempotency_key: str
    + timestamp: str
}

StandardResult "1" *-- "0..1" ServiceError : contains
StandardResult "1" *-- "1" ResultMeta : contains

' ===========================================================================
' Tool Registry
' ===========================================================================
class ToolEntry {
    + schema: type[BaseModel]
    + adapter_fn: Callable
    + action_type: str
    + risk_level: str
    + compensatable: bool
    + compensation_fn: Callable | None
}

class TOOL_REGISTRY {
    + {static} register_resident: ToolEntry
    + {static} register_vehicle: ToolEntry
    + {static} book_parking: ToolEntry
    + {static} pay_fee: ToolEntry
    + {static} execute(tool_name, params, key): StandardResult
}

TOOL_REGISTRY "1" *-- "4" ToolEntry : contains

' ===========================================================================
' Policy structures
' ===========================================================================
class ProposedAction {
    + tool: str
    + action_type: str
    + amount: int | None
    + resource_id: str | None
    + risk_level: str
}

enum PolicyDecision {
    AUTO_ALLOWED
    REQUIRES_APPROVAL
    DENIED
}

class PolicyRule {
    + id: int
    + condition: Callable[[ProposedAction], bool]
    + decision: PolicyDecision
}

ProposedAction ..> PolicyDecision : evaluated by\nPolicy Engine

' ===========================================================================
' Recovery structures
' ===========================================================================
class RecoveryContext {
    + error_code: str
    + retryable: bool
    + retry_count: int
    + completed_steps: list[StepResult]
    + failed_step: StepResult
}

enum RecoveryStrategy {
    RETRY
    REPLAN
    REQUEST_HUMAN
    COMPENSATE
    FAIL_WORKFLOW
}

RecoveryContext ..> RecoveryStrategy : determines

